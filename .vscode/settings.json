{
  "files.associations": {
    "*.v": "verilog",
    "*.vh": "verilog",
    "*.sv": "systemverilog",
    "*.svh": "systemverilog",
    "*.xdc": "tcl",
    "*.sdc": "tcl"
  },
  "files.exclude": {
    "**/.git": true,
    "**/.Xil": true,
    "**/__pycache__": true,
    "**/*.runs": true,
    "**/*_Runs": true,
    "**/impl_*": true,
    "**/synth_*": true,
    "**/sim/work": true,
    "**/*.bit": true,
    "**/*.bin": true,
    "**/*.db": true,
    "**/*.fsdb": true,
    "**/*.jou": true,
    "**/*.log": true,
    "**/*.mcs": true,
    "**/*.str": true,
    "**/*.vcd": true,
    "**/*.vvp": true,
    "**/*Zone.Identifier": true,
    "**/Realtime_PyAudio_FFT-master": true
  },
  "search.exclude": {
    "**/.git": true,
    "**/.Xil": true,
    "**/__pycache__": true,
    "**/*.runs": true,
    "**/*_Runs": true,
    "**/impl_*": true,
    "**/synth_*": true,
    "**/sim/work": true,
    "**/*.db": true,
    "**/*.fsdb": true,
    "**/*.jou": true,
    "**/*.log": true,
    "**/*.vcd": true,
    "**/*.vvp": true,
    "**/Realtime_PyAudio_FFT-master": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.Xil/**": true,
    "**/__pycache__/**": true,
    "**/*.runs/**": true,
    "**/*_Runs/**": true,
    "**/impl_*/**": true,
    "**/synth_*/**": true,
    "**/sim/work/**": true,
    "**/CM0_Proj.cache/**": true,
    "**/CM0_Proj.hw/**": true,
    "**/CM0_Proj.ip_user_files/**": true,
    "**/CM0_Proj.sim/**": true,
    "**/SR1.cache/**": true,
    "**/SR1.hw/**": true
  }
}
